// Cloudflare Workers static-assets config for MarkdownWizard.app.
// Deploy with:  npx wrangler deploy   (from this directory)
// Then attach the custom domain in the dashboard:
//   Workers & Pages → markdownwizard → Settings → Domains & Routes.
{
  "name": "markdownwizard",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "."
  }
}
