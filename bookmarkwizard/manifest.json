{
  "manifest_version": 3,
  "name": "BookmarkWizard",
  "version": "1.0.0",
  "description": "A minimalist bookmark manager in your toolbar — keep the bookmarks bar hidden.",
  "homepage_url": "https://github.com/MichalAFerber/MichalAFerber/tree/main/bookmarkwizard",
  "minimum_chrome_version": "114",
  "permissions": ["bookmarks", "favicon", "storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BookmarkWizard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open BookmarkWizard"
    }
  }
}
